# Edge function secrets — set via `supabase secrets set` or the dashboard
# (Supabase → Edge Functions → Secrets). SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected automatically by the platform.

# Xero custom connection (machine-to-machine, authorised against GAUFCC)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Anthropic API key — receipt extraction, statement parsing, commentary
ANTHROPIC_API_KEY=

# Public site origin used for invite redirects, e.g. https://gaufcc-finance.pulseaccountants.co.uk
SITE_URL=
